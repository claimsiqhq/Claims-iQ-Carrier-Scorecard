# ==============================================================================
# Claims iQ Audit — Environment Variables
# Copy to .env and fill in the secret values (never commit a real .env).
# On Render, set these in the dashboard for the claims-iq-api service.
# ==============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
# Port the API listens on. Render sets PORT automatically — do not set it there.
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# Background processing worker for claim ingestion/audits ("false" to disable)
DURABLE_WORKER_ENABLED=true

# ── Database (Supabase PostgreSQL) — REQUIRED ─────────────────────────────────
# Direct connection string. Find it: Supabase Dashboard → Project Settings →
# Database → Connection string. Prefer the session pooler URL for serverless-
# style hosts (port 5432 pooler: aws-0-<region>.pooler.supabase.com).
SUPABASE_DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# Supabase service-role key (server-side only, bypasses RLS) — REQUIRED
# Supabase Dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE=<your-supabase-service-role-key>

# Supabase anon/public key (used by Supabase client for storage URL signing)
# Supabase Dashboard → Project Settings → API → anon public
SUPABASE_ANON_KEY=<your-supabase-anon-key>

# ── Email (SendGrid) ──────────────────────────────────────────────────────────
# Required for sending audit report emails
SENDGRID_API_KEY=<your-sendgrid-api-key>

# Verified sender address (defaults to john@claimsiq.ai if unset)
SENDGRID_FROM_EMAIL=john@claimsiq.ai

# Optional — shared token to authenticate the SendGrid Inbound Parse webhook
SENDGRID_INBOUND_PARSE_TOKEN=<random-shared-token>

# ── OpenAI (audit analysis + vision photo analysis) — REQUIRED ────────────────
# NOTE: On Replit these are provided by Replit AI Integrations automatically.
# Outside Replit (e.g. Render) you must use your OWN OpenAI credentials:
AI_INTEGRATIONS_OPENAI_API_KEY=<your-openai-api-key>
AI_INTEGRATIONS_OPENAI_BASE_URL=https://api.openai.com/v1

# Model used for carrier audits (default: gpt-4o)
OPENAI_CARRIER_AUDIT_MODEL=gpt-4o

# Max PDF pages sent to Vision AI per claim (default: 250)
OPENAI_VISION_MAX_PDF_PAGES=250

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes).
# Add your Render static site URL and any custom domains.
ALLOWED_ORIGINS=https://claims-iq-web.onrender.com

# ── Frontend build (claims-iq static site) ────────────────────────────────────
# URL prefix the frontend is served from ("/" for root)
BASE_PATH=/
