# ==============================================================================
# Complete iQ Carrier Audit — Environment Variables
# Copy to .env and fill in the secret values (never commit a real .env).
# On Render, set these in the dashboard for the Complete iQ API service.
# ==============================================================================

# ── Server ────────────────────────────────────────────────────────────────────
# Port the API listens on. Render sets PORT automatically — do not set it there.
PORT=8080
NODE_ENV=production
LOG_LEVEL=info

# Background processing worker for claim ingestion/audits ("false" to disable)
DURABLE_WORKER_ENABLED=true

# ── Database (Supabase PostgreSQL) — REQUIRED ─────────────────────────────────
# Owner credentials are migration-only and must not be used by a running API.
MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<db-password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# Used only by migrate/migrate:storage:* entrypoints for the one-time verified
# carrier-tenant copy. Never name or read this as runtime SUPABASE_SERVICE_ROLE.
MIGRATION_SUPABASE_SERVICE_ROLE=<your-supabase-service-role-key>
# Legacy deletion remains disabled unless the retention-approved command is
# invoked with its exact approval value; do not set an approval by default.

# Provision one NOINHERIT LOGIN per plane and grant it only the corresponding
# claims_iq_* capability role created by the tenant RLS migration.
IDENTITY_DATABASE_URL=postgresql://claims_iq_identity_login:<password>@<host>:5432/postgres
TENANT_DATABASE_URL=postgresql://claims_iq_tenant_login:<password>@<host>:5432/postgres
PLATFORM_DATABASE_URL=postgresql://claims_iq_platform_login:<password>@<host>:5432/postgres
OPERATIONS_DATABASE_URL=postgresql://claims_iq_worker_login:<password>@<host>:5432/postgres

# Local/test only. Production rejects owner-role runtime fallback.
ALLOW_UNRESTRICTED_DATABASE_URL_FALLBACK=false

# Supabase project URL — REQUIRED
SUPABASE_URL=https://<project-ref>.supabase.co

# Runtime Storage uses the publishable key and a server-minted tenant JWT.
# Signing material is server-only and must never use a frontend-prefixed name.
SUPABASE_PUBLISHABLE_KEY=<your-supabase-publishable-key>
SUPABASE_JWT_SECRET=<at-least-32-byte-project-jwt-secret>
# Asymmetric alternative: set these three instead of SUPABASE_JWT_SECRET.
SUPABASE_JWT_PRIVATE_KEY=
SUPABASE_JWT_KEY_ID=
SUPABASE_JWT_ALGORITHM=RS256
SUPABASE_STORAGE_JWT_TTL_SECONDS=60

# ── Email (SendGrid) ──────────────────────────────────────────────────────────
# Required for sending audit report emails
SENDGRID_API_KEY=<your-sendgrid-api-key>

# Verified sender address
SENDGRID_FROM_EMAIL=<your-verified-sender@example.com>

# Inbound Parse routes are tenant-specific database records with an exact
# recipient, SHA-256 route/secret hashes, and a SendGrid security-policy key.
SENDGRID_INBOUND_SIGNATURE_MAX_AGE_SECONDS=300
INBOUND_EMAIL_SESSION_TTL_SECONDS=120

# ── Google Gemini (audit analysis + vision photo analysis) — REQUIRED ─────────
# Get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=<your-gemini-api-key>

# Optional override of the Gemini OpenAI-compatible endpoint
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Model used for all audit, extraction, and vision calls.
# Set this exact variable in Render to switch models without a code change.
GEMINI_MODEL=gemini-3.6-flash

# Max PDF pages sent to Gemini Vision per claim (default: 250)
GEMINI_VISION_MAX_PDF_PAGES=250

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed frontend origins (no trailing slashes).
# Add your Render static site URL and any custom domains.
ALLOWED_ORIGINS=https://scorecard.neurovista.ai,https://complete-iq-carrier-audit-iq6g.onrender.com

# Canonical frontend URL used only for server-generated invitation/reset links.
APP_PUBLIC_URL=https://scorecard.neurovista.ai
PASSWORD_RESET_TTL_MINUTES=60
INVITATION_TTL_HOURS=48
PLATFORM_TENANT_ACCESS_TTL_MINUTES=60

# ── Frontend build (claims-iq static site) ────────────────────────────────────
# URL prefix the frontend is served from ("/" for root)
BASE_PATH=/
