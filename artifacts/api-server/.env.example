PORT=8080
# Owner credentials are used only by the pre-deploy migration command.
MIGRATION_DATABASE_URL=postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres
# One-time carrier-tenant Storage copy credential. Only migration entrypoints
# read this name; normal API/worker Storage must never use a service role.
MIGRATION_SUPABASE_SERVICE_ROLE=
# Long-running processes require distinct NOBYPASSRLS login roles granted the
# matching claims_iq_* capability role created by the RLS migration.
IDENTITY_DATABASE_URL=postgresql://claims_iq_identity_login:<password>@<host>:5432/postgres
TENANT_DATABASE_URL=postgresql://claims_iq_tenant_login:<password>@<host>:5432/postgres
PLATFORM_DATABASE_URL=postgresql://claims_iq_platform_login:<password>@<host>:5432/postgres
OPERATIONS_DATABASE_URL=postgresql://claims_iq_worker_login:<password>@<host>:5432/postgres
# Local/test only; production always rejects this owner-credential fallback.
ALLOW_UNRESTRICTED_DATABASE_URL_FALLBACK=false
SUPABASE_URL=https://<project-ref>.supabase.co
# Server runtime uses the publishable key plus a short-lived tenant JWT.
# Never expose either signing value to frontend build variables.
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_JWT_SECRET=
# Asymmetric alternative: set these three instead of SUPABASE_JWT_SECRET.
SUPABASE_JWT_PRIVATE_KEY=
SUPABASE_JWT_KEY_ID=
SUPABASE_JWT_ALGORITHM=RS256
SUPABASE_STORAGE_JWT_TTL_SECONDS=60
ALLOWED_ORIGINS=http://localhost:5173
APP_PUBLIC_URL=http://localhost:5173
PASSWORD_RESET_TTL_MINUTES=60
INVITATION_TTL_HOURS=48
PLATFORM_TENANT_ACCESS_TTL_MINUTES=60

# Google Gemini (required)
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
GEMINI_MODEL=gemini-3.6-flash
GEMINI_VISION_MAX_PDF_PAGES=250

# Email setup
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
# Inbound routes, per-route webhook-secret hashes, exact recipients, and
# SendGrid security-policy public keys are migration-managed in
# public.inbound_email_routes.
SENDGRID_INBOUND_SIGNATURE_MAX_AGE_SECONDS=300
INBOUND_EMAIL_SESSION_TTL_SECONDS=120
